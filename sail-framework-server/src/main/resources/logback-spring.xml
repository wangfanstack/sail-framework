<configuration>

    <!-- 应用名：来自 spring.application.name，用于拼接日志文件名 -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="sail-framework-server"/>

    <!-- ============================================================
         日志格式
         ============================================================ -->

    <!--
        参考 Spring Boot defaults.xml。

        不使用 %L（行号）：
        行号计算需要捕获调用栈帧，是 Logback 成本较高的转换符。
        日常排障使用 logger 名称 + 日志上下文即可。

        [traceId,spanId]：
        入口请求由 Micrometer Tracing 写入 MDC；
        异步线程池与 Redis Stream 消费线程由框架恢复（无链路时为空）。
    -->
    <property name="CONSOLE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] [%X{traceId:-},%X{spanId:-}] %cyan(%logger{36}) - %msg%n"/>

    <!-- 文件日志不输出 ANSI 颜色码 -->
    <property name="FILE_LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{traceId:-},%X{spanId:-}] %-5level %logger{36} - %msg%n"/>


    <!-- ============================================================
         日志目录
         ============================================================ -->

    <!--
        Spring Boot 配置 logging.file.path 时会注入 LOG_PATH。

        如果没有配置 logging.file.path，
        则回退到 ${user.home}/logs。

        当前项目各 profile 使用 logging.file.name，
        因此这里保持与现有配置兼容。
    -->
    <property name="LOG_DIR" value="${LOG_PATH:-${user.home}/logs}"/>


    <!-- ============================================================
         Console
         ============================================================ -->

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ============================================================
         全量日志
         
         ${LOG_FILE} 由 Spring Boot 的 logging.file.name 注入。
         
        例如：
        ${user.home}/logs/sail-framework-server.log
         
         该文件记录所有 INFO / WARN / ERROR 等日志。
         ============================================================ -->

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>

        <file>${LOG_FILE}</file>

        <!-- 每天 + 文件大小滚动 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_FILE}.%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <!-- 只保留 1 天的归档日志 -->
            <maxHistory>1</maxHistory>

            <!-- 应用启动时清理过期归档日志 -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>

            <!-- 单文件最大 50MB -->
            <maxFileSize>50MB</maxFileSize>

            <!-- 全量日志归档总大小最大 3GB -->
            <totalSizeCap>3GB</totalSizeCap>

        </rollingPolicy>

    </appender>


    <!-- ============================================================
         全量日志异步 Appender
         
         AsyncAppender 只能绑定一个下游 Appender。
         
         ASYNC -> FILE
         ============================================================ -->

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">

        <!--
            默认队列达到 80% 时会丢弃 TRACE / DEBUG / INFO。
            设置为 0，关闭该丢弃策略。
        -->
        <discardingThreshold>0</discardingThreshold>

        <!-- 异步队列 -->
        <queueSize>512</queueSize>

        <appender-ref ref="FILE"/>

    </appender>


    <!-- ============================================================
         INFO 日志
         
         只接受 INFO。
         WARN / ERROR 不进入该文件。
         ============================================================ -->

    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>

        <file>${LOG_DIR}/info/${APP_NAME}-info.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>${LOG_DIR}/info/${APP_NAME}-info.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <maxHistory>30</maxHistory>

            <maxFileSize>50MB</maxFileSize>

            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>


    <!-- ============================================================
         INFO 异步 Appender
         
         ASYNC_INFO -> INFO_FILE
         ============================================================ -->

    <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">

        <discardingThreshold>0</discardingThreshold>

        <queueSize>512</queueSize>

        <appender-ref ref="INFO_FILE"/>

    </appender>


    <!-- ============================================================
         WARN 日志
         
         只接受 WARN。
         INFO / ERROR 不进入该文件。
         ============================================================ -->

    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>

        <file>${LOG_DIR}/warn/${APP_NAME}-warn.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>${LOG_DIR}/warn/${APP_NAME}-warn.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <maxHistory>30</maxHistory>

            <maxFileSize>50MB</maxFileSize>

            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>


    <!-- ============================================================
         WARN 异步 Appender
         
         ASYNC_WARN -> WARN_FILE
         
         注意：
         AsyncAppender 只能绑定一个下游 Appender。
         因此不能把 INFO_FILE + WARN_FILE 放在同一个 AsyncAppender。
         ============================================================ -->

    <appender name="ASYNC_WARN" class="ch.qos.logback.classic.AsyncAppender">

        <discardingThreshold>0</discardingThreshold>

        <queueSize>512</queueSize>

        <appender-ref ref="WARN_FILE"/>

    </appender>


    <!-- ============================================================
         ERROR 日志
         
         ERROR 不走异步。
         
         原因：
         ERROR 日志通常用于故障排查、监控和告警。
         直接写盘可以减少异步队列/应用退出导致的日志丢失风险。
         ============================================================ -->

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>UTF-8</charset>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>

        <file>${LOG_DIR}/error/${APP_NAME}-error.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>${LOG_DIR}/error/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <maxHistory>30</maxHistory>

            <maxFileSize>50MB</maxFileSize>

            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

    </appender>


    <!-- ============================================================
         Root Logger
         ============================================================ -->

    <root level="INFO">

        <!-- 控制台 -->
        <appender-ref ref="STDOUT"/>

        <!--
            全量日志：
            INFO / WARN / ERROR
            都会进入 ${APP_NAME}.log
        -->
        <appender-ref ref="ASYNC"/>

        <!--
            分级日志：
            INFO -> info/
            WARN -> warn/
        -->
        <appender-ref ref="ASYNC_INFO"/>
        <appender-ref ref="ASYNC_WARN"/>

        <!-- ERROR 同步直写 -->
        <appender-ref ref="ERROR_FILE"/>

    </root>

</configuration>