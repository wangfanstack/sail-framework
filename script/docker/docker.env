## mysql
MYSQL_DATABASE=ruoyi-vue-pro
MYSQL_ROOT_PASSWORD=123456

## server
JAVA_OPTS=-Xms512m -Xmx512m -Djava.security.egd=file:/dev/./urandom

DATASOURCE_URL=jdbc:mysql://sail-framework-mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
DATASOURCE_USERNAME=root
DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}
REDIS_HOST=sail-framework-redis

## Spring Boot Admin 监控账号（Server 登录 + Client 注册 + Actuator 回访共用）
AGRI4J_MONITOR_USERNAME=admin
AGRI4J_MONITOR_PASSWORD=admin
